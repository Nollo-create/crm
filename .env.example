# ── Sajtpress CRM environment ──────────────────────────────────────────────
# Copy to .env.local for local dev; on the server set these in the cPanel
# Node.js App "Environment variables". NEVER commit real values.

# The CMS's OWN MySQL database (separate DB name from the webapp).
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Sajtpress integration (the connect/standalone switch) ───────────────────
# off (default) = the CMS runs entirely on its own.
# on            = it talks to the webapp's internal API.
SAJTPRESS_INTEGRATION=off

# Base URL of the webapp's internal API (no trailing slash).
WEBAPP_INTERNAL_URL=https://webapp.sajtpress.rs

# Shared server-to-server secret — must match the same value in the webapp.
# Generate a long random string; keep it out of git.
INTERNAL_API_SECRET=

# Cookie scope (audit SEC-11). LEAVE EMPTY — the CRM's session/MFA cookies are
# then host-only (crm.sajtpress.rs), which is what you want: SSO is a signed
# JWT-code handoff, NOT a shared cookie, so no CRM cookie needs the parent
# domain. Setting a parent domain (e.g. .sajtpress.rs) sends the live session
# token to EVERY *.sajtpress.rs subdomain, so a compromised sibling host could
# replay it. Only set this if you have a specific cross-subdomain need.
SESSION_COOKIE_DOMAIN=
